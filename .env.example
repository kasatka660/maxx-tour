# Copy to .env.local for development, and set the same values in your host's
# environment-variable settings for production.

# --- Telegram (required for the consultation form) --------------------------
# 1. Message @BotFather on Telegram, /newbot, copy the token it gives you.
# 2. Add the bot to the chat/group that should receive requests.
# 3. Find that chat's id: send a message there, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].chat.id
#    (group ids are negative, e.g. -1001234567890).
#
# Server-side only — do NOT prefix these with NEXT_PUBLIC_, or the token ends up
# in the browser bundle and anyone can post as your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Site ------------------------------------------------------------------
# Public origin, used to build absolute Open Graph / Twitter image URLs.
NEXT_PUBLIC_SITE_URL=https://maxxtour.by
